# Telegram bot token'i - @BotFather'dan alinir
TELEGRAM_BOT_TOKEN=123456789:AAAAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Siparislerin gonderilecegi Telegram chat/grup id'si
TELEGRAM_CHAT_ID=123456789

# Render otomatik atar, lokalde test icin sabit birakabilirsiniz
PORT=3000

# WhatsApp oturumunu kalici tutmak icin Postgres baglanti adresi
# Render'da Postgres olusturunca "Internal Database URL" degerini buraya yazin
DATABASE_URL=postgresql://kullanici:sifre@host:5432/veritabani

# Botun TÜM sohbeti yönetmesi için ZORUNLU. console.anthropic.com'dan alinir.
# Bu deger olmadan bot musteriye cevap veremez.
CLAUDE_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Opsiyonel: musteri "temsilciyle gorusmek istiyorum" derse Claude'un
# paylasacagi destek telefon numarasi. Bos birakilirsa genel bir cumle kurar.
SUPPORT_PHONE=0555 555 55 55
